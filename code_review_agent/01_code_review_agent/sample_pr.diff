diff --git a/app/auth/login.py b/app/auth/login.py
index e69de29..b6fd7f6 100644
--- a/app/auth/login.py
+++ b/app/auth/login.py
@@ -1,5 +1,10 @@
 import hashlib
 
+def check_password(user, password):
+    stored = get_stored_hash(user)
+    return hashlib.md5(password.encode()).hexdigest() == stored
+
+def get_stored_hash(user):
+    # looked up from db
+    return db.users.find_one({"name": user})["password_hash"]
